#!/usr/bin/env bash
#
# mittens — run coding agents with clean paws.
#
# The implementation moved from this script to a Rust CLI:
#
#   https://github.com/fj/mittens        (~/src/projects/jxf/mittens)
#
# This shim just execs the locally built binary so the command stays managed
# by the dotfiles. Run `mittens --help` for usage (services: claude,
# opencode).

set -euo pipefail

bin="$HOME/src/projects/jxf/mittens/target/release/mittens"

if [ ! -x "$bin" ]; then
  echo "mittens: binary not built at $bin" >&2
  echo "mittens: clone https://github.com/fj/mittens to ~/src/projects/jxf/mittens" >&2
  echo "mittens: and run: cargo build --release --manifest-path ~/src/projects/jxf/mittens/Cargo.toml" >&2
  exit 1
fi

exec "$bin" "$@"
