#!/usr/bin/env bash
#
# mittens — run coding agents with clean paws.
#
# The implementation lives in a Rust CLI:
#
#   https://github.com/fj/mittens
#
# This shim execs the cargo-installed binary so the command stays managed by
# the dotfiles, installing it via `cargo install` first if it is missing (no
# local checkout needed; `mittens self-update` updates it in place later).
# Run `mittens --help` for usage (harnesses: claude, opencode; select one
# with `mittens harness:<name>`).

set -euo pipefail

repo_url="https://github.com/fj/mittens"
root="${CARGO_INSTALL_ROOT:-${CARGO_HOME:-$HOME/.cargo}}"
bin="$root/bin/mittens"

if [ ! -x "$bin" ]; then
  echo "mittens: not installed at $bin; installing from $repo_url" >&2
  if ! command -v cargo >/dev/null; then
    echo "mittens: cannot install: cargo is not installed" >&2
    exit 1
  fi
  cargo install --locked --git "$repo_url" mittens
fi

exec "$bin" "$@"
